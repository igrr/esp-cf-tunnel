menu "Tunnel example"

    config EXAMPLE_USE_INGRESS_RULES
        bool "Route requests by the tunnel's public hostnames"
        default y
        help
            Public hostnames whose service is on localhost (e.g. http://localhost:80)
            are served by this example; others, e.g. http://192.168.1.10:8080 or
            ssh://192.168.1.10:22, are proxied to that host.

    config EXAMPLE_STREAM_WINDOW_KB
        int "HTTP/2 receive window per stream (KiB)"
        default 128
        range 64 1024
        help
            How much request body the edge sends ahead (cft_tunnel_config_t.stream_window).
            Larger is faster for uploads; a stream whose receiver is slow, e.g. a proxied
            upload to a slow host, can hold up to this much in RAM.

    config EXAMPLE_PROXY_BUFFER_KB
        int "Buffer per proxied request and direction (KiB)"
        default 16
        range 4 256
        help
            cft_tunnel_config_t.proxy_buffer_size. Larger is a little faster for
            proxied downloads.

    config EXAMPLE_DEBUG_TUNNEL
        bool "Debug logging for the tunnel connection (needs LOG_MAXIMUM_LEVEL_DEBUG)"
        default n

    config EXAMPLE_ETH_MDC_GPIO
        int "SMI MDC GPIO"
        default 31 if IDF_TARGET_ESP32P4
        default 23

    config EXAMPLE_ETH_MDIO_GPIO
        int "SMI MDIO GPIO"
        default 52 if IDF_TARGET_ESP32P4
        default 18

    config EXAMPLE_ETH_PHY_RST_GPIO
        int "PHY reset GPIO (-1 if not connected)"
        default 51 if IDF_TARGET_ESP32P4
        default 5

    config EXAMPLE_ETH_PHY_ADDR
        int "PHY address (-1 to detect)"
        default -1

endmenu
