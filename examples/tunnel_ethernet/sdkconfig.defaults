CONFIG_IDF_TARGET="esp32p4"
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
# The tunnel edge only accepts TLS 1.3
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
# Incoming TLS records from the edge are up to 16 KiB, while outgoing records
# are smaller. (MBEDTLS_DYNAMIC_BUFFER cannot be combined with TLS 1.3 in
# ESP-IDF 5.x.)
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# PSRAM: allocations above 1 KiB, lwIP buffers, and mbedTLS buffers are placed
# in PSRAM, while 64 KiB of internal RAM is reserved for AES and Ethernet DMA
# descriptors. Boards without PSRAM still boot, using internal RAM only.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# Throughput: lwIP's TCP windows bound the speed of each connection
# (window / round-trip time). A 32 KiB window increases throughput over the
# 5760-byte IDF default at the cost of additional RAM during transfers.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# Partition table with the "dotenv" partition used by nvs-dotenv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
